{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Resume",
      "type": "shell",
      "command": "/Library/TeX/texbin/latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-outdir=output",
        "main.tex"
      ],
      "options": {
        "env": {
          "PATH": "/Library/TeX/texbin:/usr/bin:/bin:/usr/sbin:/sbin"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$latex"]
    }
  ]
}
